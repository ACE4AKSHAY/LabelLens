# Mock mode works without credentials. Set live only after reviewing docs/API_CONTRACT.md.
EXTRACT_MODE=mock
VISION_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
# Optional second Google AI Studio key from another free-tier project/account.
# On quota (429), 503, or timeout the same scan retries with this key before any other fallback.
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional Z.AI fallback; requires a general Z.AI API key with credit.
# GLM Coding Plan subscriptions cannot be used by third-party apps like LabelLens.
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash
GLM_API_URL=https://api.z.ai/api/paas/v4/chat/completions
MAX_IMAGE_BYTES=10485760
MAX_TOTAL_IMAGE_BYTES=14680064
